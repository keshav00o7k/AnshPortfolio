# Site deployment URL (used for metadataBase, OG images, sitemap, and CSRF origin verification)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary Public Client Configuration (baked at build time, redeploy required if changed)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=<YOUR_CLOUDINARY_CLOUD_NAME>

# Cloudinary Server-Only Secrets (never prefixed with NEXT_PUBLIC_, never exposed to browser)
CLOUDINARY_API_KEY=<YOUR_CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<YOUR_CLOUDINARY_API_SECRET>

# Admin Authentication Secrets (server-only)
# Generate hash via: node scripts/hash-password.mjs
ADMIN_PASSWORD_HASH=<SALT_HEX>:<HASH_HEX>
# Generate secret via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=<64_CHAR_HEX_SESSION_SECRET>

# Search engine indexing control:
# Keep false (or omitted) during development and staging to prevent crawler indexing.
# Set to true in production only when the site is officially launched.
ALLOW_INDEXING=false


